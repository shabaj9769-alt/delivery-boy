{
  "expo": {
    "name": "delivery boy",
    "slug": "delivery-boy-",
    "owner": "amjad93614s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e65100"
    },
    "android": {
      "package": "com.manormart.delivery",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e65100"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.manormart.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Manor Mart Delivery uses your location to show directions to the customer's address."
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e65100"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a2304ba8-782e-4cdb-ad4a-bc973a129176"
      }
    }
  }
}
